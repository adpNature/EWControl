# PostgreSQL (docs/04-persistencia-de-datos.md)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ewcontrol
POSTGRES_USER=ewcontrol
POSTGRES_PASSWORD=

# InfluxDB (docs/04-persistencia-de-datos.md)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=ewcontrol
INFLUXDB_BUCKET=signals_history

# Auth (docs/06-seguridad-global.md, apartado 6.2)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SMTP (docs/specs/09-alarmas.md) — en docker-compose apunta al servicio mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@ewcontrol.local

# General
PORT=3000
NODE_ENV=development

# OPC UA (docs/specs/18-integracion-opc-ua.md) — allowlist anti-SSRF de endpoints: hosts y/o CIDR IPv4
# separados por comas (p. ej. 192.168.1.0/24,plc-1.local). Vacía = cualquier host (modo local de planta).
OPCUA_ALLOWED_HOSTS=
