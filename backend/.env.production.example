# Plantilla para producción. Copiar en el VPS como `backend/.env.production.local`
# (el sufijo `.local` lo excluye .gitignore — nunca commitear el fichero real).
# Generar valores nuevos para cada secreto: NUNCA reutilizar los de backend/.env.example
# ni backend/.env (esos son solo para desarrollo local).

# PostgreSQL — nombre de servicio de docker-compose.prod.yml, no localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ewcontrol
POSTGRES_USER=ewcontrol
POSTGRES_PASSWORD=

# InfluxDB — consumido por el backend
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=ewcontrol
INFLUXDB_BUCKET=signals_history

# InfluxDB — variables DOCKER_INFLUXDB_INIT_* del propio contenedor en su primer arranque
# (mismos valores que las INFLUXDB_* de arriba)
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=
DOCKER_INFLUXDB_INIT_PASSWORD=
DOCKER_INFLUXDB_INIT_ORG=ewcontrol
DOCKER_INFLUXDB_INIT_BUCKET=signals_history
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=

# Auth — generar con `openssl rand -base64 48` (uno distinto para cada secreto)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SMTP real (Mailpit solo existe en desarrollo) — proveedor transaccional (SES, Postmark, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@tudominio.com

# General
PORT=3000
NODE_ENV=production
