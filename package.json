{
  "name": "ewcontrol",
  "private": true,
  "description": "Tooling compartido de EWControl: git hooks, formato y release (Documento 0, Documento 13). El código de la plataforma vive en /backend y /frontend, cada uno con su propio package.json.",
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "semantic-release": "^25.0.8",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "prettier --write",
      "backend/node_modules/.bin/eslint --fix --config backend/eslint.config.js"
    ],
    "frontend/**/*.ts": [
      "prettier --write",
      "frontend/node_modules/.bin/eslint --fix --config frontend/eslint.config.js"
    ],
    "frontend/**/*.scss": [
      "frontend/node_modules/.bin/stylelint --fix --config frontend/.stylelintrc.json",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
