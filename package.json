{
  "name": "ewcontrol",
  "private": true,
  "description": "Tooling compartido de EWControl: git hooks, formato y release (Documento 0, Documento 13). El código de la plataforma vive en /backend y /frontend, cada uno con su propio package.json.",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "semantic-release": "^24.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "frontend/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "frontend/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
